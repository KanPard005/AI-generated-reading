{%- assign arts = site.articles | sort: "date" | reverse -%}
[{%- for a in arts -%}
{%- assign t = site.data.topics[a.topic] -%}
{"id":{{ a.slug | jsonify }},"title":{{ a.title | jsonify }},"subtitle":{{ a.subtitle | jsonify }},"url":{{ a.url | relative_url | jsonify }},"topic":{{ a.topic | jsonify }},"topic_label":{{ t.label | default: a.topic | jsonify }},"tags":{{ a.tags | jsonify }},"reading_time":{{ a.reading_time | default: 0 | jsonify }},"date":{{ a.date | date: "%Y-%m-%d" | jsonify }},"summary":{{ a.summary | jsonify }},"level":{{ a.level | jsonify }}}{% unless forloop.last %},{% endunless %}
{%- endfor -%}]
